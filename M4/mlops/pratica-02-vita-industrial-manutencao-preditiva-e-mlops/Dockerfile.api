FROM python:3.12-slim-bookworm AS docs-builder

WORKDIR /docs
COPY requirements-docs.txt .
RUN python -m pip install --no-cache-dir -r requirements-docs.txt
COPY backend/docs ./backend/docs
RUN sphinx-build -W -b html backend/docs/source /docs/html


FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install --yes --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-api.txt .
RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements-api.txt

COPY backend ./backend
COPY docs ./docs
COPY requirements.txt .
COPY --from=docs-builder /docs/html ./backend/docs/build/html

RUN groupadd --system vita \
    && useradd --system --gid vita --create-home vita \
    && mkdir -p artifacts data/raw data/processed docs/governance \
    && chown -R vita:vita /app

USER vita

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)"

CMD ["uvicorn", "backend.app:app", "--host", "0.0.0.0", "--port", "8000"]
