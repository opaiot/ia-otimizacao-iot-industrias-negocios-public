# ========================================
# Configurações MQTT
# ========================================
MQTT_BROKER=hivemq
MQTT_PORT=1883
MQTT_TOPIC=opaiot/temperature

# ========================================
# Configurações PostgreSQL
# ========================================
POSTGRES_USER=iot_user
POSTGRES_PASSWORD=iot_password
POSTGRES_DB=iot_database

# ========================================
# Configurações Backend Node.js
# ========================================
DB_HOST=postgres
DB_PORT=5432
DB_USER=iot_user
DB_PASSWORD=iot_password
DB_NAME=iot_database
NODE_ENV=production

# ========================================
# Configurações Grafana
# ========================================
GF_SECURITY_ADMIN_PASSWORD=admin
GF_SECURITY_ADMIN_USER=admin
GF_INSTALL_PLUGINS=grafana-piechart-panel
TZ=America/Sao_Paulo

# ========================================
# Configurações de Deploy
# ========================================
# Para desenvolvimento, defina como 'development'
# Para produção, defina como 'production'
ENVIRONMENT=development
