# Copie para .env apenas se quiser alterar os valores padrão do docker-compose.yml:
#   cp .env.example .env
#
# O Kafka desta prática vem da Aula 3 (M3/Aula_3_kafka/docker/).
# Suba a stack da Aula 3 antes de iniciar este compose.

# Porta publicada no host para o broker MQTT (ESP32, Wokwi, clientes locais).
# Dentro das redes Docker o broker escuta sempre em mosquitto:1883.
MQTT_HOST_PORT=1883

# Broker MQTT visto pela ponte (nome do serviço na rede Docker)
MQTT_HOST=mosquitto

# Tópico MQTT assinado pela ponte (aceita wildcard, ex.: opaiot/+/air_quality)
MQTT_TOPIC=opaiot/air_quality

# Kafka visto pela ponte: nome do serviço na rede da Aula 3
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=iot.air_quality

# Valores usados quando o payload MQTT não traz esses campos
DEFAULT_SENSOR_ID=sensor-01
DEFAULT_ROOM=lab-01
DEFAULT_CO2=800
