# Copie para .env apenas se quiser alterar os valores padrao do docker-compose.yml.
#   cp .env.example .env
#
# O Kafka desta pratica vem da Aula 3 (Modulo_3/Aula_3_kafka/docker/).
# Suba o Kafka da Aula 3 antes de iniciar este compose.

# MQTT - host (ESP32, Wokwi, script no host)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=opaiot/air_quality

# MQTT - rede Docker (servico mqtt-kafka-producer)
MQTT_INTERNAL_HOST=mosquitto

# Kafka - Aula 3 no host
# Bridge no Docker acessa o Kafka do host via host.docker.internal
KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:29092
# Script executado diretamente no host
KAFKA_EXTERNAL_BOOTSTRAP=localhost:29092
KAFKA_TOPIC=iot.air_quality

# Bridge MQTT -> Kafka
DEFAULT_SENSOR_ID=sensor-01
DEFAULT_ROOM=lab-01
DEFAULT_CO2=800
