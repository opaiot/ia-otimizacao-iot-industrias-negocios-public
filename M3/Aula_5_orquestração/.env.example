# Copie para .env apenas se quiser alterar os valores padrão do docker-compose.yaml.

# Sensor simulator
DEVICE_ID=device-001
SENSOR_MQTT_TOPIC=iot/device-001/telemetry
PUBLISH_INTERVAL=2

# Bridge MQTT -> Kafka
BRIDGE_MQTT_TOPIC=iot/+/telemetry
KAFKA_TOPIC=iot.telemetry

# Kafka para ferramentas executadas no host
KAFKA_INTERNAL_BOOTSTRAP=kafka:9092
KAFKA_EXTERNAL_BOOTSTRAP=localhost:29092

# Grafana de laboratório
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
